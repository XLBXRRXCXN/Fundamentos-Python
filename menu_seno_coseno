def seno(angulo):
    s=0
    i=0
    w=angulo*0.0174533
    while(i<=15):
        x=pow(-1,i)
        y=pow(w,(2*i)+1)
        z=factorial((2*i)+1)
        s=s+((x*y)/z)
        i=i+1

    return s

def coseno(angulo):
    s=0
    i=0
    w=angulo*0.0174533
    while(i<=15):
        x=pow(-1,i)
        y=pow(w,(2*i))
        z=factorial((2*i))
        s=s+((x*y)/z)
        i=i+1

    return s

